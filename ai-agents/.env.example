# ---------------- Servidor ----------------
PORT=3002
# Header api-key que debe mandar el bot (AI_AGENTS_API_KEY del bot, el mismo valor)
AI_AGENTS_API_KEY=change_this_ai_agents_key
# Logs: info | debug (muestra cada llamada al modelo y a las herramientas)
RUST_LOG=info

# ---------------- Base de datos (la misma del backend) ----------------
DATABASE_URL=postgres://admin:secretpassword@localhost/notiasis
# DATABASE_MAX_CONNECTIONS=5

# ---------------- DeepSeek (chat del agente) ----------------
DEEPSEEK_API_KEY=your_deepseek_api_key
# Por defecto: deepseek-flash, thinking activo y razonamiento al máximo.
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=max      # low | high | max
# DEEPSEEK_MAX_TOKENS=               # vacío = máximo del modelo (128K con max)
# DEEPSEEK_TIMEOUT_SECS=600
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------- Gemini 3.5 Transcribe (notas de voz) ----------------
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TRANSCRIBE_LANGUAGES=es-419  # BCP-47 separados por coma; vacío = autodetección
# GEMINI_TRANSCRIBE_MODE=smart        # smart (texto limpio) | verbatim
# GEMINI_TIMEOUT_SECS=120

# ---------------- Backend de NotiAsis ----------------
BACKEND_API_URL=http://localhost:3000
# api_key propia de este servicio en la tabla api_keys (no la del bot)
BACKEND_API_KEY=your_ai_agents_backend_api_key

# ---------------- Dropi (webhooks de N8N, estado en vivo) ----------------
N8N_API_KEY=your_n8n_api_key
# DROPI_N8N_URL=https://n8n.notiasis.com/webhook/dropi

# ---------------- Agente de atención al cliente ----------------
# Modo borrador: genera la respuesta y la deja en los logs, sin enviarla.
# CUSTOMER_AGENT_DRY_RUN=false
# Solo responde a estos teléfonos (pruebas). Vacío = todos.
# CUSTOMER_AGENT_ALLOWED_PHONES=573003579384
# CUSTOMER_AGENT_QUIET_SECONDS=15         # espera por si el cliente sigue escribiendo
# CUSTOMER_AGENT_MAX_REPLIES_PER_HOUR=6   # anti-bucles con respuestas automáticas
# CUSTOMER_AGENT_ESCALATION_QUIET_HOURS=8
# CUSTOMER_AGENT_HISTORY_LIMIT=100
# CUSTOMER_AGENT_GUIDE_LIMIT=10
# CUSTOMER_AGENT_MAX_TOOL_ROUNDS=8
# CUSTOMER_AGENT_MAX_CONCURRENT_TURNS=8
# CUSTOMER_AGENT_MAX_VOICE_NOTES=5
# CUSTOMER_AGENT_VOCABULARY=Interrapidísimo,Servientrega,Coordinadora,Envía,Forza,Nequi,Daviplata,contra entrega,guía
