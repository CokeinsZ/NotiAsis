# Meta API Config
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=your_webhook_verify_token

# DeepSeek API Config
DEEPSEEK_API_KEY=your_deepseek_api_key

# Backend Rust (API de persistencia: mensajes, chats, guías, asociados)
BACKEND_API_URL=http://localhost:3000
# API key con la que el bot obtiene su JWT (tabla api_keys de la DB)
BACKEND_API_KEY=your_bot_api_key

# Secreto para firmar los JWT del backend (cambiar en producción)
JWT_SECRET=change_this_jwt_secret
# Clientes nuevos por 24 h (límite de Meta: 250 sin verificar; se deja margen)
MESSAGING_LIMIT=230
# Cuántos de esos puede usar el seguimiento (niveles 1 y 2); el resto es para oficina
MESSAGING_TRACKING_LIMIT=80

# Base de datos PostgreSQL (la usa el backend de Rust)
DATABASE_URL=postgresql://user:password@host/notiasis

# Números autorizados para enviar guías, separados por coma.
# RESPALDO local: la fuente principal es la tabla business_associates
# (vía el backend); esto solo se usa si el backend no responde al iniciar.
# ALLOWED_SENDER_NUMBERS=+573001112233,573001112233

# Número que recibe una copia de cada notificación (depuración).
# Dejar vacío para desactivar.
# DEBUG_NOTIFICATION_NUMBER=+573003579384

# Desvía TODAS las notificaciones a este número en lugar del destinatario
# de la guía (útil en pruebas). Dejar vacío en producción.
# NOTIFICATION_OVERRIDE_NUMBER=573003579384

# Dropi (POST /notify-dropi-mcp): webhooks de N8N conectados al MCP de Dropi.
# Base de los endpoints /ordenes y /orden (este es el valor por defecto).
# DROPI_N8N_URL=https://n8n.notiasis.com/webhook/dropi
# Header api-key que exigen los webhooks (obligatorio: sin él responde 503).
N8N_API_KEY=
# Carpeta del servidor con los videos de producto, montada en el bot:
# {MEDIA_HOST_DIR}/business/{business_id}/products/*.mp4
# Por defecto /home/debian/vicky-v/media; en local, p. ej. ./media
# MEDIA_HOST_DIR=./media
