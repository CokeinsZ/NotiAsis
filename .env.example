# Meta API Config
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=your_webhook_verify_token

# DeepSeek API Config
DEEPSEEK_API_KEY=your_deepseek_api_key

# Backend Rust (API de persistencia: mensajes, chats, guías, asociados)
BACKEND_API_URL=http://localhost:3000

# Base de datos PostgreSQL (la usa el backend de Rust)
DATABASE_URL=postgresql://user:password@host/notiasis

# Números autorizados para enviar guías, separados por coma.
# RESPALDO local: la fuente principal es la tabla business_associates
# (vía el backend); esto solo se usa si el backend no responde al iniciar.
# ALLOWED_SENDER_NUMBERS=+573001112233,573001112233

# Número que recibe una copia de cada notificación (depuración).
# Dejar vacío para desactivar.
# DEBUG_NOTIFICATION_NUMBER=+573003579384

# Desvía TODAS las notificaciones a este número en lugar del destinatario
# de la guía (útil en pruebas). Dejar vacío en producción.
# NOTIFICATION_OVERRIDE_NUMBER=573003579384
